# ReturnProof Environment Configuration

# Application
PROJECT_NAME="ReturnProof API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server
HOST="127.0.0.1"
PORT=8000

# CORS Origins (JSON list or comma-separated strings)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection
# SQLite for local development:
DATABASE_URL="sqlite:///./returnproof.db"
# Azure SQL Database (future production migration):
# DATABASE_URL="mssql+pyodbc://username:password@your-server.database.windows.net/returnproof_db?driver=ODBC+Driver+18+for+SQL+Server"

# Security & JWT Authentication
# Generate in production using: openssl rand -hex 32
SECRET_KEY="returnproof-jwt-insecure-secret-key-change-in-production-only"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Logging
LOG_LEVEL="INFO"

# File Uploads
UPLOAD_DIR="uploads"

